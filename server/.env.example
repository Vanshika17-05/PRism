# Server
NODE_ENV=development
PORT=4100
CLIENT_URL=http://localhost:5173
USE_MOCKS=true
JWT_SECRET=replace-with-at-least-32-random-characters
MONGODB_URI=mongodb://127.0.0.1:27017/prism

# GitHub App (GitHub API access is free; normal rate limits apply)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# One public origin serves both the React app and /api routes.
APP_URL=http://localhost:4100

# Free local AI and Python enrichment service
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Vendor calls happen only when the selected provider's key is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest
PYTHON_SERVICE_URL=http://127.0.0.1:8100
AI_TIMEOUT_MS=120000

# Durable review queue (Redis/Redis Cloud free tier)
REDIS_URL=redis://127.0.0.1:6379
REVIEW_CONCURRENCY=2
GITHUB_RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=12

# Optional S3 object storage; local disk remains the zero-cost default.
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
LOCAL_STORAGE_DIR=./data/storage
ANALYTICS_DB_PATH=./data/analytics.sqlite
